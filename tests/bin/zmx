#!/bin/sh

# Fake zmx for the test suite. Serves canned sessions in the real
# marker-prefixed list format, logs attach/kill calls, and drops
# killed sessions from later listings so reload paths are exercised.
# State lives in $ZP_TEST_DIR: calls.log, and a no-sessions flag file.

set -eu

log="${ZP_TEST_DIR:?}/calls.log"

killed() {
	grep -q "KILL:.*$1" "$log" 2>/dev/null
}

sessions() {
	if [ -e "$ZP_TEST_DIR/no-sessions" ]; then
		return 0
	fi
	printf '\342\206\222 name=alpha.1\tpid=11\tclients=1\tcreated=1\tcwd=/tmp\n'
	printf '  name=alpha.2\tpid=12\tclients=0\tcreated=2\tcwd=/tmp\n'
	# beta carries labels (trailing tab-separated key=value fields)
	# and lives in a repo, so it also guards against those fields
	# leaking into cwd and breaking the repo-association count. Its
	# cwd is the OSC 7 URL zmx >= 1.0 reports for this host.
	printf '  name=beta\tpid=13\tclients=0\tcreated=3\tcwd=file://%s%s\tproject=zp\tenv=work\n' \
		"$(hostname)" "$ZP_TEST_DIR/root/plain"
	# gamma sits on another host, as inside SSH; omega's cwd is
	# percent-encoded with no host, which means this machine.
	printf '  name=d.gamma\tpid=14\tclients=0\tcreated=4\tcwd=file://elsewhere.example/tmp\n'
	printf '  name=d.omega.9\tpid=15\tclients=0\tcreated=5\tcwd=file:///tmp/a%%20b\n'
	# A daemon zmx cannot probe, e.g. one from an older protocol.
	# With a stand-in daemon pid recorded, it lasts only as long
	# as that process, as a real one does once killed.
	pidfile=$ZP_TEST_DIR/stale.pid
	if [ ! -e "$pidfile" ] || kill -0 "$(cat "$pidfile")" 2>/dev/null; then
		printf '  name=old.3\terr=Unexpected\tstatus=unreachable\n'
	fi
}

alive() {
	sessions | while IFS='	' read -r first rest; do
		name=${first#*name=}
		killed "$name" || printf '%s\t%s\n' "$first" "$rest"
	done
}

case $1 in
attach | kill)
	# Like real zmx, apply $ZMX_SESSION_PREFIX to every name argument.
	cmd=$1
	shift
	args=''
	for name in "$@"; do
		args="$args ${ZMX_SESSION_PREFIX:-}$name"
	done
	echo "$(echo "$cmd" | tr '[:lower:]' '[:upper:]'):[${args# }] PWD:$(pwd)" >>"$log"
	exit 0
	;;
list)
	if [ "${2:-}" = "--short" ]; then
		# Like real zmx, --short leaves out unreachable sessions.
		alive | awk -F'\t' '!/status=/ { sub(/.*name=/, "", $1); print $1 }'
	else
		alive
	fi
	;;
version)
	printf 'zmx\t\t1.0.1\nsocket_dir\t%s\n' "$ZP_TEST_DIR/sock"
	;;
history)
	# Logged separately from calls.log so the preview traffic never
	# disturbs the attach/kill glob assertions.
	echo "HISTORY:[$2]" >>"$ZP_TEST_DIR/history.log"
	seq 1 300
	;;
*)
	echo "zmx shim: unhandled command: $*" >&2
	exit 1
	;;
esac
